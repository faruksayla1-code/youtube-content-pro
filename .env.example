# Ollama Ayarları
OLLAMA_MODEL=qwen3-turkish:latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0.7

# Audio Ayarları
AUDIO_VOICE=tr-TR-AhmetNeural
AUDIO_RATE=1.0

# Video Ayarları
VIDEO_FPS=24
VIDEO_CODEC=libx264
VIDEO_PRESET=medium

# Output Ayarları
OUTPUT_DIR=output_videos
TEMP_DIR=temp
LOG_DIR=logs

# Database
DATABASE_PATH=video_generator.db

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
